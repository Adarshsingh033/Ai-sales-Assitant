# Used by docker-compose.yml. Create .env with:  bash deploy/init-env.sh <server-ip>
# Then replace every CHANGE_ME. Avoid "$" in values.

# --- Deployment ---
HOST_PORT=8080
POSTGRES_PASSWORD=
CORS_ORIGINS=http://localhost:8080

# --- App ---
APP_NAME=AI Sales Assistant
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY=

SUPERADMIN_EMAIL=CHANGE_ME
SUPERADMIN_PASSWORD=CHANGE_ME
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin

# --- AI ---
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=openai/gpt-oss-20b
LLM_FAST_MODEL=llama-3.1-8b-instant
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
VECTOR_BACKEND=auto
AI_WORKER_ENABLED=true

# --- Channels (optional) ---
WHATSAPP_APP_SECRET=
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
