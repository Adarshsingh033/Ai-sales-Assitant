APP_NAME=AI Sales Assistant
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:EWW%40123@localhost:5432/ai_sales_assistant

JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=SuperSecurePassword123!
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
# Cheaper model for query rewrite / lead analysis / summaries (falls back to the reply model if your key cannot use it)
LLM_FAST_MODEL=llama-3.1-8b-instant

# ---------------------------------------------------------------------------
# AI platform
# ---------------------------------------------------------------------------
# Fernet key that encrypts tenant API keys / WhatsApp tokens in the database. Generate once and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (If empty, a key is derived from JWT_SECRET_KEY — fine for development, set it explicitly in production.)
ENCRYPTION_KEY=

# Multilingual (Hindi/Hinglish/English...) local embeddings. Changing the model/dimension requires:
#   python -m app.scripts.reindex_knowledge
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# auto = pgvector when the extension is installed in PostgreSQL, otherwise the portable numpy backend
VECTOR_BACKEND=auto

# Background worker (job queue + follow-up scheduler) runs inside the API process; set false to run it separately
AI_WORKER_ENABLED=true

# WhatsApp: Meta App Secret enables X-Hub-Signature-256 verification (REQUIRED when APP_ENV=production)
WHATSAPP_APP_SECRET=

# Telegram: one shared bot; customers open https://t.me/<bot>?start=<tenant-slug>
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
